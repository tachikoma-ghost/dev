#!/usr/bin/env bash

set -eu -o pipefail

# Boot the dev image as a VM instead of a container.
#
# Why: rootless Docker-in-Docker does not work on every host (see README.md),
# and the usual escapes -- a privileged container, or binding the host's docker
# socket -- both hand out host root. A VM does not: the daemon inside runs as
# guest root, and the hypervisor keeps that away from the host.
#
# Nothing here needs root. Membership of the `kvm` group is the only host
# permission, and passt does the networking in userspace.

project="${1:?usage: devvm <project> <command>}"
command="${2:-help}"

root="$HOME/projects/$project/dev"
[ -d "$root" ] || { echo "devvm: no such project: $root" >&2; exit 1; }
cache="$root/cache/vm"
rootfs="$cache/rootfs.ext4"
kernel="$cache/vmlinux"
api="$cache/api.sock"
vfsd="$cache/virtiofsd.sock"
mem="${DEVVM_MEM:-8G}"
cpus="${DEVVM_CPUS:-4}"
disk_size="${DEVVM_DISK:-20G}"
ssh_port="${DEVVM_SSH_PORT:-2222}"

CHV_VERSION=v53.0
CHV_SHA256=448af3d4e59b22c2987f7df94c213ad40fb53a10d437e42b5ee6c4fce7c29ecc
CHR_SHA256=13f32ba952e6791fd901f2279be2055fbacc64005f96c42a8e90d58860df84a7

die() { echo "devvm: $*" >&2; exit 1; }
need() { command -v "$1" >/dev/null || die "$1 is not installed${2:+ ($2)}"; }

fetch() { # url sha256 dest
    local url=$1 want=$2 dest=$3 got
    [ -x "$dest" ] && return 0
    mkdir -p "$(dirname "$dest")"
    curl -fsSL -o "$dest.part" "$url" || die "download failed: $url"
    got=$(sha256sum "$dest.part" | cut -d' ' -f1)
    [ "$got" = "$want" ] || { rm -f "$dest.part"; die "checksum mismatch for $url: got $got, want $want"; }
    chmod +x "$dest.part" && mv "$dest.part" "$dest"
    echo "devvm: installed $dest"
}

cmd_deps() {
    local base=https://github.com/cloud-hypervisor/cloud-hypervisor/releases/download/$CHV_VERSION
    fetch "$base/cloud-hypervisor-static" "$CHV_SHA256" "$cache/bin/cloud-hypervisor"
    fetch "$base/ch-remote-static" "$CHR_SHA256" "$cache/bin/ch-remote"
    need virtiofsd "apt install virtiofsd"
    need passt "apt install passt"
    [ -r /dev/kvm ] && [ -w /dev/kvm ] || die "/dev/kvm is not accessible; add yourself to the kvm group and re-login"
    echo "devvm: dependencies OK"
}

cmd_image() {
    need docker "the rootfs is built from the Dockerfile"
    local tag="$project-devvm" cid tmp="$cache/export"
    ( cd "$root" && docker build -t "$tag" . ) || die "docker build failed"
    cid=$(docker create "$tag" /bin/true) || die "docker create failed"
    rm -rf "$tmp"; mkdir -p "$tmp"
    docker export "$cid" | tar -x -C "$tmp" || die "docker export failed"
    docker rm -f "$cid" >/dev/null

    # The container entrypoint supervises section3; as a VM, systemd is pid 1
    # and starts it as a unit instead.
    mkdir -p "$tmp/etc/systemd/system/multi-user.target.wants"
    cat >"$tmp/etc/systemd/system/section3.service" <<UNIT
[Unit]
Description=section3 service supervisor
After=network-online.target docker.service

[Service]
User=node
ExecStart=/home/node/.local/bin/section3
Restart=always

[Install]
WantedBy=multi-user.target
UNIT
    ln -sf ../section3.service "$tmp/etc/systemd/system/multi-user.target.wants/section3.service"

    # /workspace is the virtio-fs share, mounted by the guest at boot.
    mkdir -p "$tmp/workspace"
    echo "workspace /workspace virtiofs defaults 0 0" >>"$tmp/etc/fstab"

    cp "$tmp/boot/vmlinuz-"* "$cache/vmlinuz" 2>/dev/null || die "no kernel in the image; is setup/vm.sh enabled in the Dockerfile?"
    # Debian builds virtio_blk as a module, so a direct kernel boot without an
    # initramfs cannot mount /dev/vda and panics.
    cp "$tmp/boot/initrd.img-"* "$cache/initrd" 2>/dev/null || die "no initramfs in the image; update-initramfs may have failed during the build"
    mke2fs -q -t ext4 -d "$tmp" -F "$rootfs" "$disk_size" || die "mke2fs failed"
    rm -rf "$tmp"
    echo "devvm: built $rootfs ($disk_size)"
}

cmd_kernel() {
    [ -f "$cache/vmlinuz" ] || die "run 'devvm $project image' first"
    need extract-vmlinux "from linux source scripts/; see README.md"
    extract-vmlinux "$cache/vmlinuz" > "$kernel.part" || die "extract-vmlinux failed"
    mv "$kernel.part" "$kernel"
    # cloud-hypervisor boots a PVH entry point, not a bzImage. Without the Xen
    # PVH note the VM fails with an unhelpful error, so check here instead.
    readelf -n "$kernel" 2>/dev/null | grep -qi xen \
        || die "$kernel has no PVH note; cloud-hypervisor cannot boot it. See README.md"
    echo "devvm: PVH kernel at $kernel"
}

cmd_start() {
    [ -f "$rootfs" ] || die "no rootfs; run 'devvm $project image'"
    [ -f "$kernel" ] || die "no kernel; run 'devvm $project kernel'"
    [ -f "$cache/initrd" ] || die "no initramfs; run 'devvm $project image'"
    [ -S "$api" ] && die "already running (api socket $api exists)"
    mkdir -p "$cache"

    virtiofsd --socket-path="$vfsd" --shared-dir="$HOME/projects/$project" --sandbox=none &
    passt --socket "$cache/passt.sock" --tcp-ports "$ssh_port:22" &

    "$cache/bin/cloud-hypervisor" \
        --api-socket "$api" \
        --kernel "$kernel" \
        --initramfs "$cache/initrd" \
        --cmdline "console=hvc0 root=/dev/vda rw" \
        --disk path="$rootfs" \
        --fs tag=workspace,socket="$vfsd" \
        --net "socket=$cache/passt.sock" \
        --cpus "boot=$cpus" \
        --memory "size=$mem,shared=on" \
        --console tty --serial null &

    echo "devvm: started; ssh with 'devvm $project ssh' once it has booted"
}

cmd_ssh() { ssh -p "$ssh_port" -o StrictHostKeyChecking=accept-new node@127.0.0.1 "${@:-}"; }
cmd_stop() { [ -S "$api" ] || die "not running"; "$cache/bin/ch-remote" --api-socket "$api" shutdown-vmm; }
cmd_status() { [ -S "$api" ] && "$cache/bin/ch-remote" --api-socket "$api" info || echo "devvm: not running"; }

case "$command" in
    deps)   cmd_deps ;;
    image)  cmd_image ;;
    kernel) cmd_kernel ;;
    start)  cmd_start ;;
    ssh)    shift 2; cmd_ssh "$@" ;;
    stop)   cmd_stop ;;
    status) cmd_status ;;
    *) cat <<USAGE
devvm <project> <command> -- boot the dev image as a VM

  deps    fetch cloud-hypervisor, check virtiofsd/passt/kvm
  image   build the rootfs from the project's Dockerfile
  kernel  extract a PVH vmlinux from the image's kernel
  start   boot the VM
  ssh     ssh into it (port $ssh_port)
  stop    shut it down
  status  ask the VMM

Env: DEVVM_MEM=$mem DEVVM_CPUS=$cpus DEVVM_DISK=$disk_size DEVVM_SSH_PORT=$ssh_port
USAGE
    ;;
esac
